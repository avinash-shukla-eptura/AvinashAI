{
  "mcpServers": {
    "endor-cli-tools": {
      "command": "cmd",
      "args": [
        "/c",
        "endorctl",
        "ai-tools",
        "mcp-server"
      ]
    },
    "basic-memory": {
      "command": "basic-memory",
      "args": [
        "mcp",
        "--project=aid-avinash-ai"
      ]
    },
    "atlassian": {
      "command": "cmd",
      "args": [
        "/c",
        "mcp-remote",
        "https://mcp.atlassian.com/v2/mcp"
      ]
    },
    "reflex": {
      "type": "http",
      "url": "https://api.52.152.170.200.nip.io/mcp"
    }
  }
}
